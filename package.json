{
  "name": "avm-web-provider",
  "private": true,
  "description": "A TypeScript implementation that allows clients to connect and interact with web-based providers.",
  "engines": {
    "node": "^22.x"
  },
  "packageManager": "pnpm@10.3.0",
  "scripts": {
    "build": "pnpm -F @agoralabs-sh/avm-web-provider build",
    "build:docs": "pnpm -F documentation build",
    "check:types": "pnpm -F @agoralabs-sh/avm-web-provider check:types",
    "clean": "pnpm -F @agoralabs-sh/avm-web-provider clean",
    "clean:docs": "pnpm -F documentation clean",
    "lint": "eslint .",
    "prepare": "husky",
    "prettier": "prettier --write \"**/*.{cjs,js,json,mjs,ts}\"",
    "serve:docs": "pnpm -F documentation serve",
    "start:docs": "pnpm -F documentation start",
    "test": "pnpm -F @agoralabs-sh/avm-web-provider test"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "1.1.8",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@commitlint/types": "^19.5.0",
    "@eslint/js": "^9.20.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.15.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "prettier": "^3.2.5",
    "semantic-release": "^24.1.1",
    "typescript-eslint": "^8.24.1"
  }
}
